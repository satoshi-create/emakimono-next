<file path="src/styles/OverlayEkotoba.module.css">
.container {
  height: 100%;
  position: relative;
}

.ekotobaimagebox {
  writing-mode: horizontal-tb;
  /* LazyImage が width/height:100% のため、縦書き親配下でもパーセント基準を確定させる */
  width: 100%;
  height: 100%;
  min-width: 0;
}

/* 詞書画像なし章マーカー: フロー上の幅をゼロにし、タイトルは absolute で隣接絵に重ねる */
.noEkotobaImage {
  width: 0;
  min-width: 0;
  height: 100%;
  overflow: visible;
}

.markerSection {
  width: 0;
  min-width: 0;
  overflow: visible;
  flex-shrink: 0;
  height: 100%;
}

/* レイアウトは横書き基準。タイトル文字だけ縦書きにして下にアイコンを積む */
.chapterbox {
  writing-mode: horizontal-tb;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: fit-content;
  letter-spacing: 0.1rem;
  z-index: 10;
  color: var(--clr-white);
  position: absolute;
  top: 0;
  background-color: #000;
  max-width: none;
  width: max-content;
  overflow: visible;
}

/* 縦書きタイトルの直下にアイコン（フォントサイズに追従） */
.chapterActions {
  writing-mode: horizontal-tb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 0;
  margin-top: 0.15rem;
  flex-shrink: 0;
  font-size: 1em;
}
.chapterActions :global(button) {
  width: 1.15em;
  height: 1.15em;
  min-width: 1.15em;
  min-height: 1.15em;
  padding: 0;
  font-size: 1em;
}
.chapterActions :global(button svg) {
  width: 1em;
  height: 1em;
}
/* SP: タップは overlayFramed の padding で確保（親幅を超えないよう em 基準） */
@media (pointer: coarse) {
  .chapterActions {
    gap: 0;
    margin-top: 0.1rem;
  }
  .chapterActions :global(button) {
    width: 1.15em;
    height: 1.15em;
    min-width: 1.15em;
    min-height: 1.15em;
  }
}

/* モバイルファースト: 縦横どちらも小さめの clamp（横画面でも 768px ブレークで大きくならない） */
.chapterboxPrt {
  padding: 0.4rem 0.32rem 0.36rem;
  font-size: clamp(0.68rem, 0.55rem + 0.65vw, 0.88rem);
}

.chapterboxLand {
  padding: 0.38rem 0.32rem 0.34rem;
  font-size: clamp(0.68rem, 0.55rem + 0.65vw, 0.88rem);
}

/* SP / タッチ: 縦書きタイトル列のみ幅制限（いいね行は別幅でクリップしない） */
@media (max-width: 1023px), (pointer: coarse) {
  .chapterboxPrt,
  .chapterboxLand {
    overflow: visible;
    max-width: none;
  }

  .chapter {
    max-width: 2.5em;
    max-height: 40vh;
    overflow: hidden;
  }

  .chapterActions {
    overflow: visible;
    width: max-content;
    align-self: center;
  }
}

/* タブレット（1024px 未満の横画面スマホは上のモバイルサイズのまま） */
@media (min-width: 1024px) {
  .chapterbox {
    letter-spacing: 0.15rem;
  }

  .chapterboxPrt {
    padding: 0.6rem 0.5rem 0.5rem;
    font-size: clamp(0.875rem, 0.6rem + 1vw, 1.25rem);
  }

  .chapterboxLand {
    padding: 0.55rem 0.5rem 0.45rem;
    font-size: clamp(1rem, 0.8rem + 1vw, 1.5rem);
  }
}

/* デスクトップ */
@media (min-width: 1280px) {
  .chapterbox {
    letter-spacing: 0.2rem;
  }

  .chapterboxPrt {
    padding: 0.75rem 0.6rem 0.55rem;
  }

  .chapterboxLand {
    padding: 0.65rem 0.6rem 0.5rem;
    font-size: var(--title-size);
  }

  .chapterActions :global(button) {
    width: 0.8em;
    height: 0.8em;
    min-width: 0.8em;
    min-height: 0.8em;
  }
}

.chapter {
  font-weight: 400;
  font-family: var(--font-classical);
  white-space: normal;
  word-break: keep-all;
  overflow-wrap: anywhere;
  text-transform: capitalize;
  line-height: 1.3;
  max-height: 85vh;
}

.ekotobarl .chapter {
  writing-mode: vertical-rl;
}

.ekotobalr .chapter {
  writing-mode: vertical-lr;
}

/* ポートレート（縦向き・スマホ）用 — サイズは chapterbox から継承 */
.chapterPrt {
  font-size: 1em;
}

/* ランドスケープ（横向き・PC/タブレット）用 */
.chapterLand {
  font-size: 1em;
}

/* ===========================
 * 右⇒左（rl）の設定
 * =========================== */

.ekotobarl {
  writing-mode: vertical-rl;
  z-index: 1;
  right: 0;
}

.ekotobarl .chapterbox {
  right: 1rem;
}

/* ===========================
 * 左⇒右（lr）の設定
 * =========================== */
.ekotobalr {
  writing-mode: vertical-lr;
  z-index: 1;
}

.ekotobalr .chapterbox {
  left: 1rem;
}

.container::-webkit-scrollbar {
  height: 15px;
}

@media (min-width: 768px) {
  .container::-webkit-scrollbar {
    height: 20px;
  }
}
</file>

