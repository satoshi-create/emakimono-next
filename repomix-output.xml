.trigger {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 0.6rem;
  margin: 1.5rem 0 0.5rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--clr-grey-light);
  border-radius: var(--borderRadius, 8px);
  background: var(--clr-surface);
  font-family: var(--font-ui);
  text-align: left;
  cursor: pointer;
  user-select: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.trigger:hover {
  border-color: var(--clr-accent-green);
}

.trigger:focus-visible {
  outline: 2px solid var(--clr-accent);
  outline-offset: 2px;
}

.summaryBadge {
  display: inline-block;
  padding: 0.125rem 0.75rem;
  border-radius: 999px;
  color: #fff;
  font-size: 0.8125rem;
  font-weight: 600;
  line-height: 1.7;
  white-space: nowrap;
}

.summaryTitle {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--clr-text);
  flex: 1;
}

.chevron {
  font-size: 0.75rem;
  color: var(--clr-text-muted);
}

.fullLink {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: 1rem;
  font-family: var(--font-ui);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--clr-accent-green);
  text-decoration: none;
  transition: var(--transition);
}

.fullLink:hover {
  opacity: 0.8;
}

.fallback {
  margin: 1.5rem 0 0.5rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--clr-grey-light);
  border-radius: var(--borderRadius, 8px);
  background: var(--clr-surface);
}

/* ===== モーダル ===== */

.modalOverlay {
  position: fixed;
  inset: 0;
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

.modalBackdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.45);
  cursor: pointer;
  z-index: -1;
}

.modal {
  position: relative;
  display: flex;
  flex-direction: column;
  width: min(680px, 100%);
  max-height: 85vh;
  background: var(--clr-bg);
  border-radius: 16px;
  padding: 1.25rem 1.25rem 2rem;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
  animation: modalIn 0.2s ease-out;
}

.modalHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.modalTitle {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  font-family: var(--font-ui);
}

.modalPeriod {
  font-size: 0.875rem;
  font-weight: 400;
  color: var(--clr-text-muted);
}

.modalClose {
  flex-shrink: 0;
  width: 2rem;
  height: 2rem;
  border: 1px solid var(--clr-grey-light);
  border-radius: 999px;
  background: var(--clr-surface);
  color: var(--clr-text-muted);
  font-size: 1.125rem;
  line-height: 1;
  cursor: pointer;
  transition: var(--transition);
}

.modalClose:hover {
  opacity: 0.7;
}

.modalClose:focus-visible {
  outline: 2px solid var(--clr-accent);
  outline-offset: 2px;
}

.modalBody {
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-right: 0.25rem;
}

.modalFullLink {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: 1.25rem;
  padding-bottom: 0.5rem;
  font-family: var(--font-ui);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--clr-accent-green);
  text-decoration: none;
  transition: var(--transition);
}

.modalFullLink:hover {
  opacity: 0.8;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media screen and (max-width: 767px) {
  .modalOverlay {
    align-items: flex-end;
    padding: 0;
  }

  .modal {
    width: 100%;
    max-height: 85vh;
    border-radius: 16px 16px 0 0;
  }
}
</file>

