}

/*
 * モバイル（〜1023px）: 縦=バー内 / 横=左下隅フロート（ナビ idle 連動）
 * ブレークポイントは SceneCommentaryBar の SP 判定と揃える
 */
@media (max-width: 1023px) {
  .fabWrap[data-variant="float"][data-orientation="portrait"] {
    display: none;
  }

  .fabWrap[data-variant="bar"][data-orientation="portrait"] {
    display: inline-flex;
    pointer-events: auto;
  }

  .fabWrap[data-variant="bar"][data-orientation="landscape"] {
    display: none;
  }

  .fabWrap[data-variant="float"][data-orientation="landscape"] {
    display: inline-flex;
    left: calc(0.25rem + env(safe-area-inset-left, 0px));
    bottom: calc(0.25rem + env(safe-area-inset-bottom, 0px));
  }

  .fabWrap[data-variant="bar"][data-orientation="portrait"] .fab {
    padding: 0.35rem 0.65rem;
    font-size: 0.75rem;
    gap: 0.3rem;
    max-width: 100%;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  }

  .fabWrap[data-variant="bar"][data-orientation="portrait"] .fabIcon {
    font-size: 0.85rem;
  }

  .fabWrap[data-variant="bar"][data-orientation="portrait"] .fabLabel {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .fabWrap[data-variant="float"][data-orientation="landscape"] .fab {
    padding: 0.3rem 0.55rem;
    font-size: 0.7rem;
    gap: 0.25rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.14);
  }

  .fabWrap[data-variant="float"][data-orientation="landscape"] .fabIcon {
    font-size: 0.8rem;
  }
}
</file>

