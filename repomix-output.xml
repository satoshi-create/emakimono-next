    desc,
    descen,
    edition,
  } = scroll;

  const scrollTitle =
    locale === "ja"
      ? `${title}${edition ? ` ${edition}` : ""}`
      : titleen;
  const snippet = locale === "en" ? firstSentence(descen) : firstSentence(desc);

  return (
    <article className={styles.scrollCard}>
      <Link href={`/${titleen}`}>
        <a className={styles.scrollCardInner}>
          {thumb && (
            <div className={styles.scrollCardThumbWrap}>
