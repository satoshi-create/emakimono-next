                        })}
                      </option>
                    </select>
                    <button
                      type="button"
                      className={styles.chapterSortDirButton}
                      onClick={() =>
                        setSortDir((dir) => (dir === "asc" ? "desc" : "asc"))
                      }
                    >
                      {sortDir === "asc"
                        ? t("genjiHub.sortAsc", {
                            defaultValue: isEn ? "Ascending" : "昇順",
                          })
                        : t("genjiHub.sortDesc", {
                            defaultValue: isEn ? "Descending" : "降順",
