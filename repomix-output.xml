<file path="src/styles/EmakiHub.module.css">
/* ============ 京都・鎌倉編 ハブ ============ */

/* --- Hero（和モダン ダークグラデ帯） --- */
.hero {
  background: linear-gradient(to right, #121212, #1f2326);
  color: #fff;
  padding: 4rem 5vw 5rem;
  text-align: center;
}

.heroInner {
  max-width: 1100px;
  margin: 0 auto;
}

.heroTitle {
  font-family: var(--font-story);
  font-size: clamp(1.5rem, 4vw, 2.6rem);
  line-height: 1.4;
  letter-spacing: 0.04em;
}

.heroLead {
  font-family: var(--font-ui);
  font-size: clamp(0.9rem, 2vw, 1.1rem);
  color: rgb(255 255 255 / 0.78);
  margin-top: 1rem;
}

/* --- RegionSwitcher --- */
.regionSwitch {
  display: inline-flex;
  gap: 0.5rem;
  margin-top: 2rem;
  padding: 0.35rem;
  background: rgb(255 255 255 / 0.08);
  border-radius: 999px;
}

.regionTab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.1rem;
  padding: 0.6rem 1.6rem;
  border: none;
  border-radius: 999px;
  background: transparent;
  color: rgb(255 255 255 / 0.75);
  font-family: var(--font-ui);
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}

.regionTab:hover {
  color: #fff;
}

.regionTabActive {
  background: var(--clr-accent);
  color: #fff;
}

.regionTabJa {
  font-size: 1rem;
  font-weight: 700;
}

.regionTabEn {
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.85;
}

/* --- セクション見出し --- */
.sectionTitle {
  font-family: var(--font-story);
  font-size: clamp(1.4rem, 3vw, 2rem);
  color: var(--clr-text);
}

.sectionDesc {
  font-family: var(--font-ui);
  font-size: 0.95rem;
  color: var(--clr-text-muted);
  margin-top: 0.5rem;
}

/* --- カテゴリーフィルタ（地図左上オーバーレイ） --- */
.mapFilter {
  position: absolute;
  top: 0.75rem;
  left: 3rem;
  z-index: 1100;
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  max-width: calc(100% - 3.75rem);
  padding: 0.4rem;
  background: rgb(255 255 255 / 0.92);
  border: 1px solid rgb(211 211 211 / 0.6);
  border-radius: 12px;
  box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
}

.themeTab {
  padding: 0.4rem 0.9rem;
  border: 1px solid var(--clr-grey-light);
  border-radius: 999px;
  background: var(--clr-surface);
  color: var(--clr-text);
  font-family: var(--font-ui);
  font-size: 0.82rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.themeTab:hover {
  border-color: var(--clr-accent);
}

.themeTabActive {
  background: var(--clr-accent);
  border-color: var(--clr-accent);
  color: #fff;
}

/* --- マップ --- */
.mapWrap {
  position: relative;
  /* 地図内オーバーレイ（1100 等）をコンテキスト内に閉じ込め、ヘッダーより上に出ないようにする */
  z-index: 0;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgb(211 211 211 / 0.6);
}

/* 全画面表示時（mapWrap ごと固定配置でビューポートを覆う） */
.mapWrapFullscreen {
  position: fixed;
  inset: 0;
  z-index: 9999;
  border-radius: 0;
  border: none;
}

/* 内側の mapWrap（EmakiHubMap の外枠）と Leaflet コンテナも全体に伸ばす */
.mapWrapFullscreen .mapWrap,
.mapWrapFullscreen .map {
  height: 100%;
  min-height: 0;
}

.map {
  min-height: 60vh;
  width: 100%;
}

.mapLoading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  border-radius: 12px;
  border: 1px solid rgb(211 211 211 / 0.6);
  color: var(--clr-text-muted);
  font-family: var(--font-ui);
}

/* --- 全画面表示トグル（地図右上） --- */
.mapFullscreenBtn {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  z-index: 1150;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 1px solid rgb(211 211 211 / 0.6);
  border-radius: 10px;
  background: rgb(255 255 255 / 0.94);
  color: var(--clr-text);
  font-family: var(--font-ui);
  font-size: 0.95rem;
  cursor: pointer;
  box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
  transition: color 0.2s ease, background 0.2s ease;
}

.mapFullscreenBtn:hover {
  color: var(--clr-accent);
}

.mapPinWrap {
  background: transparent;
  border: none;
}

.mapPin {
  width: 34px;
  height: 42px;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgb(0 0 0 / 0.3);
}

.mapPin span {
  transform: rotate(45deg);
  color: #fff;
  font-size: 0.78rem;
  font-weight: 700;
}

.mapPinActive {
  box-shadow: 0 0 0 6px rgb(255 140 119 / 0.35), 0 0 0 2px rgb(255 140 119 / 0.6),
    0 2px 8px rgb(0 0 0 / 0.35);
  animation: mapPinPulse 1.6s ease-in-out infinite;
}

@keyframes mapPinPulse {
  0%,
  100% {
    box-shadow: 0 0 0 6px rgb(255 140 119 / 0.35), 0 0 0 2px rgb(255 140 119 / 0.6),
      0 2px 8px rgb(0 0 0 / 0.35);
  }
  50% {
    box-shadow: 0 0 0 12px rgb(255 140 119 / 0.15), 0 0 0 2px rgb(255 140 119 / 0.6),
      0 2px 8px rgb(0 0 0 / 0.35);
  }
}

.mapPopupCard {
  min-width: 200px;
  font-family: var(--font-ui);
}

.mapPopupImg {
  width: 100%;
  aspect-ratio: 16 / 10;
  object-fit: cover;
  border-radius: 8px;
  background: rgb(0 0 0 / 0.06);
  margin-bottom: 0.5rem;
}

.mapPopupImgPlaceholder {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 16 / 10;
  border-radius: 8px;
  background: linear-gradient(135deg, #f0f2f5, #e2e6ea);
  color: var(--clr-text-muted);
  font-family: var(--font-story);
  font-size: 0.85rem;
  margin-bottom: 0.5rem;
}

.mapPopupTitle {
  font-family: var(--font-story);
  font-weight: 700;
  font-size: 0.98rem;
  color: var(--clr-text);
}

.mapPopupTitleEn {
  font-size: 0.75rem;
  color: var(--clr-text-muted);
  margin-top: 0.1rem;
}

.mapPopupSpot {
  font-size: 0.8rem;
  color: var(--clr-accent-green);
  margin-top: 0.4rem;
}

.mapPopupDesc {
  font-size: 0.78rem;
  line-height: 1.6;
  color: var(--clr-text-muted);
  margin-top: 0.35rem;
}

.mapPopupBtn {
  display: inline-block;
  margin-top: 0.6rem;
  padding: 0.4rem 0.9rem;
  border-radius: 8px;
  background: var(--clr-accent);
  color: #fff;
  font-size: 0.8rem;
  text-decoration: none;
}

.mapPopupBtn:hover {
  opacity: 0.85;
}

.mapPopupSoon {
  display: inline-block;
  margin-top: 0.6rem;
  padding: 0.4rem 0.9rem;
  border-radius: 8px;
  background: var(--clr-grey-light);
  color: #fff;
  font-size: 0.8rem;
}

.mapPopupGmap {
  display: block;
  margin-top: 0.5rem;
  font-size: 0.78rem;
  color: var(--clr-link);
}

/* --- トップページ帯（観光マップへの誘導） --- */
.topBanner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  max-width: 1200px;
  margin: 1.25rem auto 0;
  padding: 0.9rem 1.5rem;
  border-radius: 12px;
  background: linear-gradient(
    to right,
    rgb(255 140 119 / 0.12),
    rgb(84 137 106 / 0.12)
  );
  border: 1px solid rgb(255 140 119 / 0.35);
  text-decoration: none;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.topBanner:hover {
  border-color: var(--clr-accent);
  background: linear-gradient(
    to right,
    rgb(255 140 119 / 0.2),
    rgb(84 137 106 / 0.2)
  );
}

.topBannerTitle {
  font-family: var(--font-story);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--clr-text);
}

.topBannerCta {
  font-family: var(--font-ui);
  font-size: 0.85rem;
  color: var(--clr-accent);
  white-space: nowrap;
}

/* --- セクションナビ --- */
.sectionNav {
  display: flex;
  gap: 1.5rem;
  max-width: 1320px;
  margin: 0 auto;
  padding: 0.75rem 5vw;
  font-family: var(--font-ui);
  font-size: 0.875rem;
  border-bottom: 1px solid rgb(211 211 211 / 0.4);
}

.sectionNav a {
  color: var(--clr-link);
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.sectionNav a:hover {
  opacity: 0.7;
  text-decoration: underline;
}

.sectionAnchor {
  scroll-margin-top: 6rem;
}

/* --- おすすめルートパネル（地図右側・折りたたみ式オーバーレイ） --- */
.routePanel {
  position: absolute;
  top: 3.5rem; /* 全画面トグルボタンの下から表示 */
  right: 0.75rem;
  bottom: 0.75rem;
  z-index: 1100;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  width: 360px;
  max-width: calc(100% - 1.5rem);
  padding: 1rem;
  background: rgb(255 255 255 / 0.97);
  border: 1px solid rgb(211 211 211 / 0.6);
  border-radius: 12px;
  box-shadow: 0 4px 20px rgb(0 0 0 / 0.16);
  font-family: var(--font-ui);
}

.routePanelHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.routePanelTitle {
  font-family: var(--font-story);
  font-size: 1.1rem;
  color: var(--clr-text);
  margin: 0;
}

.routePanelClose {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border: none;
  border-radius: 50%;
  background: var(--clr-surface);
  color: var(--clr-text-muted);
  cursor: pointer;
  font-size: 0.9rem;
  transition: color 0.2s ease, background 0.2s ease;
}

.routePanelClose:hover {
  color: var(--clr-accent);
  background: rgb(255 140 119 / 0.12);
}

.routePanelDesc {
  font-size: 0.82rem;
  line-height: 1.6;
  color: var(--clr-text-muted);
  margin: 0;
}

.routePanelList {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  overflow-y: auto;
  padding-right: 0.25rem;
  -webkit-overflow-scrolling: touch;
}

/* パネル内のルートカードはコンパクト表示 */
.routePanel .routeCard {
  padding: 0.9rem;
  gap: 0.6rem;
  box-shadow: none;
}

.routePanel .routeCard:hover {
  transform: none;
  box-shadow: 0 4px 12px rgb(0 0 0 / 0.08);
}

.routePanel .routeStopImg {
  display: none;
}

.routePanel .routeSummary {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.routePanel .routeBtn {
  font-size: 0.78rem;
  padding: 0.45rem 0.8rem;
}

.routePanel .routeStopNote {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 閉状態のトグルボタン（地図右下・帰属表示の上） */
.routePanelToggle {
  position: absolute;
  right: 0.75rem;
  bottom: 2.5rem;
  z-index: 1100;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.1rem;
  border: none;
  border-radius: 999px;
  background: var(--clr-text);
  color: #fff;
  font-family: var(--font-ui);
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 3px 12px rgb(0 0 0 / 0.25);
  transition: opacity 0.2s ease, background 0.2s ease;
}

.routePanelToggle:hover {
  opacity: 0.88;
  background: var(--clr-accent);
}

/* ルート選択中のトグル（押すとルート解除） */
.routePanelToggleActive {
  background: var(--clr-accent);
}
.routePanelToggleActive:hover {
  background: var(--clr-text);
}

.routeCard {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
  padding: 1.3rem;
  background: var(--clr-surface);
  border: 1px solid rgb(211 211 211 / 0.5);
  border-radius: 12px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.routeCard:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
}

.routeHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.routeTitle {
  font-family: var(--font-story);
  font-size: 1.1rem;
  color: var(--clr-text);
}

.routeTitleEn {
  font-family: var(--font-ui);
  font-size: 0.78rem;
  color: var(--clr-text-muted);
  margin-top: 0.15rem;
}

.routeDuration {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  flex-shrink: 0;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  background: var(--clr-accent-green);
  color: #fff;
  font-family: var(--font-ui);
  font-size: 0.72rem;
  white-space: nowrap;
}

.routeSummary {
  font-family: var(--font-ui);
  font-size: 0.85rem;
  line-height: 1.7;
  color: var(--clr-text-muted);
}

.routeStops {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.routeStop {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
}

.routeStopNum {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--clr-accent);
  color: #fff;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 700;
  margin-top: 0.15rem;
}

.routeStopImg {
  flex-shrink: 0;
  width: 56px;
  height: 42px;
  object-fit: cover;
  border-radius: 6px;
  background: rgb(0 0 0 / 0.06);
}

.routeStopBody {
  min-width: 0;
}

.routeStopLabels {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.stopBadgeEmaki,
.stopBadgeSpot {
  padding: 0.15rem 0.5rem;
  border-radius: 999px;
  font-family: var(--font-ui);
  font-size: 0.66rem;
  font-weight: 700;
  flex-shrink: 0;
}

.stopBadgeEmaki {
  background: rgb(255 140 119 / 0.16);
  color: #b3503c;
}

.stopBadgeSpot {
  background: rgb(84 137 106 / 0.16);
  color: var(--clr-accent-green);
}

.routeStopName {
  font-family: var(--font-ui);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--clr-text);
}

.routeStopNote {
  font-family: var(--font-ui);
  font-size: 0.78rem;
  line-height: 1.6;
  color: var(--clr-text-muted);
  margin-top: 0.2rem;
}

.routeBtn {
  margin-top: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.6rem 1rem;
  border: none;
  border-radius: 8px;
  background: var(--clr-accent);
  color: #fff;
  font-family: var(--font-ui);
  font-size: 0.88rem;
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.routeBtn:hover {
  opacity: 0.85;
}

/* --- 漫画・アニメ関連カード --- */
.mediaGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.mediaCard {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--clr-surface);
  border: 1px solid rgb(211 211 211 / 0.5);
  border-radius: 12px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.mediaCard:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
}

.mediaThumb {
  aspect-ratio: 16 / 9;
  background: rgb(0 0 0 / 0.06);
}

.mediaThumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mediaThumbPlaceholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  font-family: var(--font-story);
  color: var(--clr-text-muted);
  background: linear-gradient(135deg, #f0f2f5, #e2e6ea);
  padding: 1rem;
  text-align: center;
}

.mediaBody {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 1.1rem;
}

.mediaTypeBadge {
  align-self: flex-start;
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  background: rgb(84 137 106 / 0.14);
  color: var(--clr-accent-green);
  font-family: var(--font-ui);
  font-size: 0.7rem;
  font-weight: 700;
}

.mediaTitle {
  font-family: var(--font-story);
  font-size: 1.1rem;
  color: var(--clr-text);
}

.mediaTitleEn {
  font-family: var(--font-ui);
  font-size: 0.8rem;
  color: var(--clr-text-muted);
}

.mediaRationale {
  font-family: var(--font-ui);
  font-size: 0.85rem;
  line-height: 1.7;
  color: var(--clr-text);
}

.mediaEmakiName {
  font-family: var(--font-ui);
  font-size: 0.8rem;
  color: var(--clr-text-muted);
}

.mediaActions {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 0.3rem;
}

.mediaBtn {
  display: inline-block;
  padding: 0.5rem 0.9rem;
  border-radius: 8px;
  background: var(--clr-accent);
  color: #fff;
  font-family: var(--font-ui);
  font-size: 0.82rem;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.mediaBtn:hover {
  opacity: 0.85;
}

.mediaOfficial {
  font-family: var(--font-ui);
  font-size: 0.8rem;
  color: var(--clr-link);
  text-decoration: none;
}

.mediaOfficial:hover {
  text-decoration: underline;
}

/* --- ルート表示中のピン装飾 --- */
.mapPinDim {
  opacity: 0.35;
}

.mapPinRoute {
  box-shadow: 0 0 0 3px rgb(255 255 255 / 0.9), 0 2px 8px rgb(0 0 0 / 0.35);
}

/* --- モバイル（768px 以下） --- */
@media (max-width: 768px) {
  .hero {
    padding: 3rem 1.2rem 3.5rem;
  }

  .regionTab {
    padding: 0.55rem 1.1rem;
  }

  /* SP は地図の縦幅を伸長して見やすくする */
  .map {
    min-height: 70vh;
  }

  .mapLoading {
    min-height: 70vh;
  }

  .topBanner {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    margin-top: 1rem;
    padding: 0.9rem 1.1rem;
  }

  /* 全画面トグルは SP ではコンパクトに */
  .mapFullscreenBtn {
    top: 0.5rem;
    right: 0.5rem;
    width: 36px;
    height: 36px;
    font-size: 0.85rem;
  }

  /* ピンポップアップをマップより大きくしない（SP） */
  .mapPopupCard {
    min-width: 0;
    width: 100%;
    max-width: 220px;
  }

  .mapPopupImg,
  .mapPopupImgPlaceholder {
    aspect-ratio: 16 / 9;
    max-height: 96px;
  }

  .mapPopupTitle {
    font-size: 0.9rem;
  }

  .mapPopupDesc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mapPopupBtn {
    font-size: 0.75rem;
    padding: 0.35rem 0.8rem;
  }

  .sectionNav {
    gap: 1rem;
    overflow-x: auto;
    white-space: nowrap;
  }

  /* カテゴリーフィルタは横スクロールチップに。ボタンは小さくして地図に収める */
  .mapFilter {
    left: 3rem;
    top: 0.5rem;
    flex-wrap: nowrap;
    overflow-x: auto;
    max-width: calc(100% - 3.5rem);
    scrollbar-width: none;
  }

  .mapFilter::-webkit-scrollbar {
    display: none;
  }

  .themeTab {
    font-size: 0.66rem;
    padding: 0.25rem 0.55rem;
    white-space: nowrap;
  }

  /* SP: ルートパネルは「おすすめの観光ルート」ボタンの上に浮くプルダウン型 */
  .routePanel {
    top: auto;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 5rem; /* トグルボタンの上に重ねる */
    width: auto;
    max-height: 55%;
    max-width: none;
    padding: 0.6rem;
    gap: 0.4rem;
  }

  .routePanelTitle {
    font-size: 0.95rem;
  }

  .routePanelDesc {
    display: none;
  }

  .routePanelList {
    gap: 0.4rem;
  }

  /* ルートタイトルのみをプルダウン表示し、すべて見えるようにする */
  .routePanel .routeCard {
    padding: 0.55rem 0.7rem;
    gap: 0.4rem;
  }

  .routePanel .routeSummary,
  .routePanel .routeStops,
  .routePanel .routeBtn,
  .routePanel .routeDuration,
  .routePanel .routeTitleEn {
    display: none;
  }

  .routePanel .routeHeader {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }

  .routePanelToggle {
    right: 0.5rem;
    bottom: 2.5rem;
    font-size: 0.7rem;
    padding: 0.45rem 0.8rem;
    gap: 0.3rem;
    max-width: 60vw;
    white-space: nowrap;
  }

  .routePanelToggle span {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mediaGrid {
    grid-template-columns: 1fr;
  }

  .routeHeader {
    flex-direction: column;
    gap: 0.5rem;
  }

  .routeStopImg {
    width: 48px;
    height: 36px;
  }
}
</file>

