<file path="src/styles/FolkloreDetailSheet.module.css">
/* .entry-container（position:relative）内に Portal。viewport ではなくコンテナ矩形基準 */
.root {
  position: absolute;
  inset: 0;
  z-index: 35;
  pointer-events: none;
}

.backdrop {
  position: absolute;
  inset: 0;
  border: 0;
  padding: 0;
  margin: 0;
  background: transparent;
  cursor: default;
  pointer-events: none;
}

/* 解説バー直上に底揃え。高さはコンテンツフィット（上方向へ伸長）。
   上限のみ max-height（ヘッダー下〜解説バー上）。top+bottom 同時指定はしない。
   --folklore-sheet-bottom は SceneCommentaryBar が .entry-container へ実測公開。
   未設定時はリスト展開を安全にカバーする 460px */
.sheet {
  position: absolute;
  top: auto;
  right: var(--folklore-sheet-right, 16px);
  bottom: var(--folklore-sheet-bottom, 460px);
  width: min(340px, calc(100% - 32px));
  height: auto;
  max-height: calc(
    100% - var(--folklore-sheet-top, 68px) - var(--folklore-sheet-bottom, 460px)
  );
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 12px;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  font-family: var(--font-ui);
  color: var(--clr-text);
  pointer-events: auto;
  padding: 12px 14px 0;
  animation: folkloreSheetIn 0.22s ease-out;
  transition: transform 0.2s ease-out;
  z-index: 35;
}

.sheet.dragging {
  transition: none;
}

@keyframes folkloreSheetIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.header {
