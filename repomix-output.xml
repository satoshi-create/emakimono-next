    :root {
      --vh-45: 45svh;
    }
  }
  @media (orientation: landscape) {
    :root {
      --vh-75: 75svh;
    }
  }
}

/* Safe area inset support for notched devices */
@supports (padding: env(safe-area-inset-bottom)) {
