  background: rgb(255 140 119 / 0.08);
  color: var(--clr-accent, #ff8c77);
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 700;
  line-height: 1.5;
  white-space: nowrap;
  text-decoration: none;
