                  </svg>
                </div>
                <p className={styles.label}>{t("help.useArrowKeys")}</p>
              </div>
            </>
          ) : (
            // PC（非タッチデバイス）: ホイール + 矢印キー + スクロールバー
            <>
              <div className={styles.helpItem}>
                <div className={styles.iconWrapper}>
                  {/* マウスホイールアイコン */}
