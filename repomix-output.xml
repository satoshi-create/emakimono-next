}
@media (pointer: coarse) {
  .modeTabs {
    padding: 0 10px 4px;
    gap: 6px;
  }
  .modeTab {
    padding: 4px 12px;
    font-size: 0.75rem;
  }
}

.bodyText,
.gendaibun {
  font-size: 0.85rem;
  line-height: 1.45;
  color: #333;
  font-family: var(--font-story);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bodyTextClassical {
  /* 古文も現代文・解説と同じストーリー体 */
  font-family: var(--font-story);
  line-height: 1.7;
}

/* 展開時: 行数制限を解除し、冒頭文＋続きを1段落のまま全文表示する */
.bar[data-expanded="true"] .bodyText,
.bar[data-expanded="true"] .gendaibun {
  display: block;
  -webkit-line-clamp: unset;
  -webkit-box-orient: unset;
  overflow: visible;
}

/* 展開時は上寄せ（center だと長い古文で先頭が枠外に隠れる） */
.bar[data-expanded="true"] .body {
  justify-content: flex-start;
}

/* 古文展開時は長い詞書でも読めるよう少しスクロール可に */
.bar[data-expanded="true"][data-text-mode="kobun"] .body {
  max-height: min(42vh, 280px);
  overflow-y: auto;
}

/* ×（解説バーを閉じる）: 操作列の右端に配置 */
