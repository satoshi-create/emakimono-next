<file path="src/styles/globals.css">
/* Tailwind v3 directives removed: incompatible with @tailwindcss/postcss v4 plugin */
/* Tailwind utility classes are not used in this project (CSS Modules + Chakra UI) */

*,
::after,
::before {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  /* Viewport height with dvh fallback for mobile browsers */
  /* dvh (dynamic viewport height) adjusts for mobile URL bar */
  --vh-100: 100vh;
  --vh-75: 75vh;
  --vh-45: 45vh;

  /* Semantic colors (single light mode) */
  --clr-bg: #fff;
  --clr-surface: #f9fbff;
  --clr-text: rgb(20 20 20);
  --clr-text-muted: rgb(114 114 114);
  --clr-accent: #ff8c77;
  --clr-accent-green: #54896a;

  /* Legacy color tokens (keep for existing CSS Modules) */
  --clr-black: var(--clr-text);
  --clr-grey: var(--clr-text-muted);
  --clr-grey-light: rgb(163, 163, 163);
  --clr-white: var(--clr-bg);
  --clr-primary-02: rgba(117, 159, 238, 0.3);
  --clr-accent-01: #ff3a3a;
  --clr-accent-02: var(--clr-accent);
  --clr-green-01: var(--clr-accent-green);
  --clr-link: #065fd4;
  --clr-bcg: var(--clr-surface);

  /* Typography — 3 font stacks (JTBD: UI / story / classical overlay) */
  --font-ui: "Noto Sans JP", system-ui, -apple-system, sans-serif;
  --font-story: "Zen Maru Gothic", sans-serif;
  --font-classical: "Hina Mincho", serif;

  /* Legacy font aliases */
  --my-font: var(--font-ui);
  --title-font: var(--font-ui);
  --title-font2: var(--font-ui);
  --title-font3: var(--font-ui);
  --title-font-3: var(--font-ui);
  --emaki-title-font: var(--font-ui);
  --text-font: var(--font-story);
  --text-font-koten: var(--font-classical);
  --text-font-koten2: var(--font-classical);
  --emaki-kotobagki-font: var(--font-story);
  --handwriting-font-1: var(--font-story);
  --handwriting-font-2: var(--font-story);
  /* ワイドディスプレイ対応: 高さと横幅の両方を考慮した可変フォントサイズ */
  /* 高さベースの計算と横幅ベースの計算の大きい方を採用 */
  --text-size: max(
    calc(16px + (35 - 16) * ((100vh - 375px) / (1080 - 375))),
    clamp(16px, 1.2vw, 28px)
  );
  --text-size-prt: clamp(0.875rem, 0.6583rem + 0.9245vw, 1.25rem);
  --title-size: max(
    calc(20px + (35 - 20) * ((100vh - 375px) / (1080 - 375))),
    clamp(20px, 1.4vw, 32px)
  );
  --title-size-prt: clamp(1rem, 0.6389rem + 1.5408vw, 1.625rem);
  --mokuji-size: max(
    calc(14px + (20 - 14) * ((100vh - 375px) / (1080 - 375))),
    clamp(14px, 1vw, 22px)
  );
  --shadow-1: 0 5px 15px rgb(0 0 0 / 10%);
  --shadow-2: 0 5px 15px rgba(0, 0, 0, 20%);
  --shadowR: -10px 15px 10px rgba(0, 0, 0, 0.2);
  --transition: all 0.3s linear;
  --borderRadius: 0.5rem;
}

body {
  background-color: var(--clr-bg);
  color: var(--clr-text);
  font-family: var(--font-ui);
  line-height: 1.5;
}

/* Sticky footer: short pages keep footer at viewport bottom */
.site-shell {
  min-height: var(--vh-100);
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
}

.site-shell > main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.site-shell > footer,
.site-shell > main > footer {
  margin-top: auto;
}

h1,
h2,
h3,
h4 {
  line-height: 1.5;
}

ul {
  list-style: none;
}

a {
  text-decoration: none;
  color: var(--clr-black);
  cursor: pointer;
}

button {
  background: transparent;
  border-color: transparent;
  cursor: pointer;
}

.section-grid {
  display: grid;
  grid-template-columns: 1fr min(calc(100vw - (5vw * 2)), 1200px) 1fr;
}

/* ワイド版（観光マップ等の地図・カード主体ページ用） */
.section-grid-wide {
  display: grid;
  grid-template-columns: 1fr min(calc(100vw - (5vw * 2)), 1320px) 1fr;
}

.section-grid>*,
.section-grid-wide>* {
  grid-column: 2;
}

.emaki-page-landscape-grid {
  display: grid;
  /* ワイドディスプレイ対応: 最大幅制限を削除し、左右5vwマージンを維持 */
  grid-template-columns: 5vw 1fr 5vw;
}

.emaki-page-landscape-grid>* {
  grid-column: 2;
}

.section-padding {
  padding: 2rem 0;
}

@media screen and (min-width: 768px) {
  .section-padding {
    padding: 4rem 0;
  }
}

/* トップページ ヒーロー（H1 + 紹介文） */
.hero {
  text-align: center;
}

.heroTitle {
  margin: 0 0 1rem;
  font-family: var(--font-story);
  font-size: clamp(1.8rem, 1.3955rem + 1.7257vw, 2.5rem);
  font-weight: 500;
  line-height: 1.4;
  color: var(--clr-text);
  word-break: auto-phrase;
}

.heroDesc {
  margin: 0 auto 1rem;
  font-family: var(--font-ui);
  font-size: clamp(1rem, 0.8844rem + 0.4931vw, 1.2rem);
  line-height: 1.8;
  width: clamp(20rem, 2.6656rem + 73.9599vw, 50rem);
  text-align: justify;
  color: var(--clr-text-muted);
}

.fade-in {
  opacity: 0.3;
  transition: 1s;
}

.fade-in.lazyloaded {
  opacity: 1;
}

.fullscreen-enabled {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.fullscreen-enabled .entry-container {
  width: 100%;
  height: 100%;
  /* 全画面時は article 下端の横スクロールバーをクリップしないよう、
     JS 側でも overflow:hidden を外す。ここは縦はみ出し防止のみ */
  overflow-x: hidden;
  overflow-y: hidden;
}

.fullscreen-enabled article {
  /* ボトムコメントバーはオーバーレイのため、絵巻はビューポート高で表示。
     横スクロールバーは border-box 内に収まる（外側に余白を作らない） */
  height: var(--vh-100);
  max-height: var(--vh-100);
  width: 100%;
  max-width: 100%;
  /* ノッチ端末対応: 全画面時に safe-area を確保 */
  padding-left: var(--safe-area-left, 0px);
  padding-right: var(--safe-area-right, 0px);
  box-sizing: border-box;
}

/* ハンバーガーメニュー＆モーダル画面を固定 */
.open html,
.open body {
  overflow: hidden;
  height: 100%;
}

/* twitter wedgids */
.twitter-container {
  display: grid;
  place-content: center;
}

.twitter-timeline {
  width: clamp(18.75rem, 0.6934rem + 77.0416vw, 50rem);
  height: 500px;
  overflow-y: auto;
  overflow-x: hidden;
}

/* スクロールバー */
@media (pointer: fine) {
  .scrollbar {
    /* Firefox向け: つまみの色とトラックの色を指定 */
    /* トラックを透過にして「つまみだけが浮いて見える」表現を実現 */
    scrollbar-color: rgba(204, 204, 204, 0.74) transparent;
    scrollbar-width: auto;

    /* スクロールバーの太さと背景色 (WebKit系: Chrome, Safari, Edge) */
    &::-webkit-scrollbar,
    &::-webkit-scrollbar-corner {
      width: 40px;
      height: 40px;
      background: transparent;
    }

  }

  .scrollbar {

    /* 矢印ボタンのスペースを削除 */
    &::-webkit-scrollbar-button {
      width: 0;
      height: 0;
    }

    /*  */
    /* ハンドルの最小の長さ、色、角丸半径 */
    &::-webkit-scrollbar-thumb {
      border: 3px solid transparent;
      border-radius: 100px;
      background-color: #ccccccbd;
      background-clip: content-box;
      width: 80px;
    }

    &::-webkit-scrollbar-thumb:hover {
      background-color: #afafafbd;
    }
  }
}

/* 全画面モード（PC）: 通常時と同じスクロールバー色を使う。
   色・つまみは上記 .scrollbar を継承し、ここでの色上書きはしない */
@media (pointer: fine) {
  .fullscreen-enabled .scrollbar {
    overflow-x: scroll;
  }
}

/* モバイルで隠す */
.hide-on-mobile {
  @media (width <=768px) {
    display: none !important;
  }
}

/* モバイルで表示 */
.show-on-mobile {
  @media (width > 768px) {
    display: none !important;
  }
}

/* scroll-hint */
@keyframes scroll-hint-appear {
  0% {
    transform: translateX(-40px);
    opacity: 0;
  }

  10% {
    opacity: 1;
  }

  50%,
  100% {
    transform: translateX(40px);
    opacity: 0;
  }
}

.scroll-hint.is-right-scrollable {
  background: linear-gradient(270deg, rgba(0, 0, 0, .15) 0, rgba(0, 0, 0, 0) 16px, rgba(0, 0, 0, 0));
}

.scroll-hint.is-right-scrollable.is-left-scrollable {
  background: linear-gradient(90deg, rgba(0, 0, 0, .15) 0, rgba(0, 0, 0, 0) 16px, rgba(0, 0, 0, 0)), linear-gradient(270deg, rgba(0, 0, 0, .15) 0, rgba(0, 0, 0, 0) 16px, rgba(0, 0, 0, 0));
}

.scroll-hint.is-left-scrollable {
  background: linear-gradient(90deg, rgba(0, 0, 0, .15) 0, rgba(0, 0, 0, 0) 16px, rgba(0, 0, 0, 0));
}

.scroll-hint-icon {
  position: absolute;
  top: calc(50% - 25px);
  left: calc(50% - 60px);
  box-sizing: border-box;
  width: 120px;
  height: 80px;
  border-radius: 5px;
  transition: opacity .3s;
  opacity: 0;
  background: rgba(0, 0, 0, .7);
  text-align: center;
  padding: 20px 10px 10px 10px;
  z-index: 10;
}

.scroll-hint-icon-wrap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
