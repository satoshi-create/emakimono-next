.keywodtTitle:hover {
  opacity: 0.6;
}

.subgrid {
  display: none;
}

.tagCloud {
  border: 1px solid rgb(209 209 209);
  border-radius: 12px;
  padding: 1rem;
  margin-top: 0.5rem;
}

.recommendEmaki {
