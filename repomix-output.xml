            sizes="100vw"
            priority
          />
        </div>
      ) : null}
      <div className={styles.heroText}>
        <h1 className={styles.introTitle}>
          {t("genjiHub.pagetitle", {
            defaultValue: isEn
              ? "The Tale of Genji — 54 chapters"
              : "源氏物語 五十四帖",
