.reopenBar {
  position: relative;
  width: 100%;
  z-index: 20;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  flex-wrap: wrap;
  /* 透明な全幅領域がナビ（z-index:10）のクリックを奪わないようにする */
  pointer-events: none;
  /* 背景は透明。ボタン自体に白背景を持たせる */
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  box-shadow: none;
}
.reopenBar[data-fullscreen="true"] {
  position: absolute;
  left: auto;
  right: 1rem;
  /* バー本体と同じく、全画面ボタンの上に浮かせる */
  bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
  background: transparent;
  box-shadow: none;
}

.reopenBtn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  pointer-events: auto;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 999px;
  background: #fff;
  color: var(--clr-accent);
  font-size: 0.8rem;
  font-weight: 700;
  font-family: var(--font-ui);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
