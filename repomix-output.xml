<file path="src/styles/MangaRootsNetwork.module.css">
.wrap {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  background: var(--clr-surface);
  border: 1px solid rgb(211 211 211 / 0.5);
  border-radius: 12px;
  padding: 1rem 1rem 0.75rem;
}

.stageSlot {
  position: relative;
  width: 100%;
  height: min(52vw, 560px);
}

.stageSlotEgo {
  height: min(36vw, 320px);
}

.stage,
.stage :global(.react-flow) {
  position: absolute;
  z-index: 1;
  inset: 0;
  width: auto;
  height: auto;
  background: transparent;
  overflow: visible;
}

.stageFullscreen {
  position: fixed;
  inset: 0;
  z-index: 9999;
  width: 100vw;
  height: 100dvh;
  border-radius: 0;
  background: var(--clr-surface);
}

.zoomIcon {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  z-index: 1100;
  width: 2.5rem;
  height: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgb(211 211 211 / 0.6);
  border-radius: 10px;
  background: rgb(255 255 255 / 0.94);
  color: var(--clr-text);
  font-size: 0.95rem;
  box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
  cursor: pointer;
}

.zoomIcon:hover {
  color: var(--clr-accent);
}

.stage :global(.react-flow__viewport),
.stage :global(.react-flow__renderer),
.stage :global(.react-flow__container) {
  overflow: visible;
}

.stage :global(.react-flow__controls) {
  box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
}

.stage :global(.react-flow__controls-button) {
  width: 1.75rem;
  height: 1.75rem;
  border-bottom-color: rgb(211 211 211 / 0.5);
  background: rgb(255 255 255 / 0.95);
  fill: var(--clr-text);
}

.stage :global(.react-flow__controls-button:hover) {
  background: #fff;
}

.stage :global(.react-flow__edge-path) {
  stroke: rgb(255 140 119 / 0.5);
  stroke-width: 1.6;
}

.handle {
  opacity: 0;
  pointer-events: none;
  width: 1px;
  height: 1px;
  min-width: 1px;
  min-height: 1px;
  border: none;
}

.edge :global(.react-flow__edge-path) {
  transition: opacity 0.2s ease;
}

.edgeDim {
  opacity: 0.1;
}

.nodeLink {
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 0.35rem 0.5rem;
  box-sizing: border-box;
}

.emakiBox {
  width: 168px;
  min-height: 56px;
  background: #fff;
  border: 1.5px solid var(--clr-accent);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  transform-origin: center center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.stage :global(.react-flow__node-emaki:hover),
.stage :global(.react-flow__node-emaki:focus-within) {
  z-index: 1000 !important;
}

.stage :global(.react-flow__node-emaki:hover) .emakiBox,
.stage :global(.react-flow__node-emaki:focus-within) .emakiBox {
  transform: scale(1.35);
  box-shadow: 0 8px 22px rgb(0 0 0 / 0.16);
}

.emakiName {
  font-family: var(--font-story);
  font-size: 12px;
  color: var(--clr-text);
  font-weight: 600;
  text-align: center;
  line-height: 1.35;
}

.stage :global(.react-flow__node-media:hover),
.stage :global(.react-flow__node-media:focus-within) {
  z-index: 1000 !important;
}

.mediaBox {
  width: 156px;
  min-height: 60px;
  background: #fff;
  border: 1.5px solid var(--clr-accent-green);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  transform-origin: center center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.stage :global(.react-flow__node-media:hover) .mediaBox,
.stage :global(.react-flow__node-media:focus-within) .mediaBox {
  transform: scale(1.35);
  box-shadow: 0 8px 22px rgb(0 0 0 / 0.16);
}

.mediaName {
  font-family: var(--font-story);
  font-size: 12px;
  color: var(--clr-text);
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
}

.mediaType {
  font-family: var(--font-ui);
  font-size: 9px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--clr-text-muted);
  margin-top: 0.15rem;
}

.tagChip {
  width: 190px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(84 137 106 / 0.16);
  border: 1.4px solid var(--clr-accent-green);
  border-radius: 22px;
  cursor: pointer;
}

.tagChip:hover {
  background: rgb(84 137 106 / 0.3);
}

.tagChip:focus {
