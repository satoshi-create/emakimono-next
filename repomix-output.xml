<file path="src/styles/SceneCommentaryBar.module.css">
/* ボトムコメントバー
   ビューア最下部に常駐するシーン解説バー（1本に統一）。
   段タイトル＋解説文を折りたたみ表示し、タップで同じバー内に全文を展開する。
   フルスクリーンのみ絵巻上にオーバーレイ。
   関連: SceneCommentaryBar.js / EmakiConteiner.js */

/* entry-container に付与: 下部UI（Navigation等）をバー高さぶん持ち上げる */
.hasCommentaryBar {
  /* 縦積みレイアウト（テキスト行＋操作行）に合わせた高さ。未計測時はこの値にフォールバック */
  --commentary-bar-h: 84px;
  /* 実バー高さ（折りたたみ時は header のみ、展開時は全文ぶん伸びる）。
     SceneCommentaryBar の ResizeObserver が動的に更新する。未計測時は折りたたみ高さにフォールバック */
  --commentary-bar-full-h: var(--commentary-bar-h);
}

@media (min-width: 1024px) {
  .hasCommentaryBar {
    --commentary-bar-h: 88px;
  }
}

.bar {
  position: relative;
  width: 100%;
  z-index: 20;
  /* 1本のバーとして縦に伸びる（折りたたみ時は header のみ、展開時は全文＋段一覧まで） */
  display: flex;
  flex-direction: column;
  /* 絵巻画像上に和紙調の半透明ブラーで重ねる */
  background: rgba(255, 252, 246, 0.92);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 -2px 16px rgba(0, 0, 0, 0.12);
  color: var(--clr-text);
  font-family: var(--font-ui);
}

/* 全モード共通の縦積みレイアウト: テキストを全幅表示するため縦積みにする。
   本体（.body）を1行目いっぱいに広げ、操作アイコンは下段の専用行に分離する。
   SP（portrait / landscape）・フルスクリーン・PC すべて同じレイアウトに統一 */
.header {
  position: relative; /* ポップオーバーの基準点 */
  display: flex;
  flex-direction: column;
  align-items: stretch;
  /* 折りたたみ時の最小高さ。展開時は本文の長さに合わせてバーごと伸びる */
  min-height: var(--commentary-bar-h);
}

/* 本体（現代文）。タップで解説シートを開閉 */
.body {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 2px;
  padding: 2px 14px 6px;
  text-align: left;
  overflow: hidden;
  width: 100%;
}

/* 段タイトル行: タイトルのすぐ隣にいいね・コピー・共有 */
.titleLine {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 0.15rem;
  padding: 6px 14px 2px;
  min-width: 0;
  width: 100%;
}
.titleBtn {
  flex: 0 1 auto;
  min-width: 0;
  max-width: calc(100% - 5.5rem);
  padding: 0;
  border: none;
  background: transparent;
  text-align: left;
  cursor: pointer;
}
.titleActions {
  display: inline-flex;
  align-items: center;
  gap: 0;
  flex: 0 0 auto;
  margin-left: 0;
}
.titleActions :global(button) {
  width: 28px;
  height: 28px;
  min-width: 28px;
  min-height: 28px;
  padding: 0;
}
@media (pointer: coarse) {
  .titleLine {
    gap: 0.1rem;
    padding: 6px 10px 2px;
  }
  .titleActions :global(button) {
    width: 30px;
    height: 30px;
    min-width: 30px;
    min-height: 30px;
  }
}

.title {
  font-weight: 700;
  font-size: 0.95rem;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
