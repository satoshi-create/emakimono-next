/* Dynamic viewport height support for mobile browsers */
/* dvh adjusts automatically when mobile URL bar shows/hides */
@supports (height: 100dvh) {
  :root {
    --vh-100: 100dvh;
    --vh-75: 75dvh;
    --vh-45: 45dvh;
  }
}

/* アドレスバー出し入れによるレイアウト安定化（svh = small viewport） */
/* シーン幅は ratio * --vh-* なので dvh 変動は横 scrollWidth 揺れ＝巻き戻り感の原因になる */
@supports (height: 100svh) {
