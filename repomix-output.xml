}
.reopenBtn:hover {
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

/* バー本体と段一覧（バー内スワップ）の配置基準ラッパー。
   フルスクリーン時の右下カード配置は .wrap が担う */
.wrap {
  position: relative;
  width: 100%;
  z-index: 20;
}
.wrap[data-fullscreen="true"] {
  position: absolute;
  left: auto;
  right: 1rem;
  /* 右下コーナー固定の全画面ボタンと重ならないよう、ボトムから浮かせる */
  bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
  /* 正方形ではなく横長の長方形カードとして右下に表示する */
  width: min(420px, 38vw, calc(100% - 2rem));
  min-width: 260px;
}

/* フルスクリーン時: 絵巻鑑賞の邪魔をしないよう、右下に浮かぶカード型にする。
   全幅バーではなく角に収め、絵巻全体（100%）が表示される。
   展開時は max-height の範囲でカード内スクロールになり、絵巻上部が常に残る */
.bar[data-fullscreen="true"] {
  width: 100%;
  /* ビューポート基準: wrap の高さは内容で決まるため % は使えない */
  max-height: calc(100vh - 6.5rem - env(safe-area-inset-bottom, 0px));
  overflow-y: auto;
  overscroll-behavior: contain;
  border-radius: 12px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
}

/* 「…詳細をみる」: プルダウンを意識させるボタン風ヒント。
   クリックするとバー全体（.body）がトグルされて展開する */
.moreHint {
