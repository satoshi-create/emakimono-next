const GenjiChapterGrid = ({ chapters }) => {
  const { t } = useTranslation("common");
  const { locale } = useRouter();
  const isEn = locale === "en";

  return (
    <section className={styles.chapterSection}>
      {chapters.length === 0 ? (
        <p className={styles.chapterEmpty}>
