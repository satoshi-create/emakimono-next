  vertical-align: baseline;
  margin-left: 0.35rem;
  padding: 2px 10px;
  border: 1px solid var(--clr-accent);
  border-radius: 999px;
  background: rgba(255, 140, 119, 0.08);
  color: var(--clr-accent);
  font-weight: 700;
  font-size: 0.78rem;
  line-height: 1.5;
  white-space: nowrap;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}
.moreHint:hover {
  background: var(--clr-accent);
  color: #fff;
}

/* バー内スワップ: 段構成一覧（サムネイル付き縦リスト）。
   ポップオーバーではなく、解説バー内部の本文とスワップして表示する。
   下部ナビの持ち上がりを抑えるため高さ上限は 32vh */
.sectionIndex {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 6px 8px 4px;
  overflow-y: auto;
  overscroll-behavior: contain;
  max-height: min(280px, 32vh);
}

.indexItem {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 4px 6px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  cursor: pointer;
  text-align: left;
}
.indexItem:hover {
  border-color: rgba(0, 0, 0, 0.12);
}
.indexItemActive {
  border-color: var(--clr-accent);
  background: rgb(255 140 119 / 0.08);
}

.indexThumb {
  flex: 0 0 auto;
  width: 56px;
  height: 40px;
  object-fit: cover;
  object-position: left center;
  border-radius: 6px;
  background: #f0ece6;
}

.indexText {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1 1 auto;
}
.indexTitle {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--clr-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.indexDesc {
  font-size: 0.72rem;
  color: var(--clr-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.indexCurrent {
  flex: 0 0 auto;
  font-size: 0.65rem;
  font-weight: 700;
  color: #fff;
  background: var(--clr-accent);
  border-radius: 999px;
  padding: 2px 8px;
}

/* フローティングカード時はカード自体がスクロールするため二重スクロールを防ぐ */
.wrap[data-fullscreen="true"] .sectionIndex {
  max-height: none;
  overflow: visible;
}

/* フローティングカードのドラッグ＆ドロップ移動（全画面 or md+横）:
   既定位置（右下）へ戻るときは transform を軽くアニメーション。
   ドラッグ中は transition を切り、ポインターに追従させる */
.wrap[data-fullscreen="true"] {
  transition: transform 0.2s ease-out;
}
.wrap.dragging {
  transition: none;
}
/* ドラッグハンドルは段タイトル行。選択開始・タッチスクロールを止める。
   操作ボタン（いいね・共有等）上では JS 側でドラッグを開始しないため pointer 表示 */
.bar[data-fullscreen="true"] .header {
  -webkit-user-select: none;
