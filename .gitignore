# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# エディタで .gitignore を開いて以下を追加
/public/emaki-images/

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
dist/

# production
/build

# misc
.DS_Store
*.pem
**/.upload-cache.json
cloudinary-usage.json

# analytics (generated locally or via CI)
/analytics/reports/*/
!/analytics/reports/.gitkeep
/analytics/content-map.json

# scroll workspace (local YAML + images; sync outputs go to src/data/)
/scrolls

# python cache (analytics + scroll scripts)
scripts/__pycache__/
scripts/analytics/__pycache__/
*.pyc

# image-metadata-cache backups
src/data/image-metadata-cache/*.bak
src/data/image-metadata-cache/*.pre-migrate*.bak

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env.local
.env.production
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.history

credentials.json

.vercel
.env*

# docs: ignore all except operations/ (analytics + scroll pipelines)
/docs/*
!/docs/operations/
!/docs/operations/**