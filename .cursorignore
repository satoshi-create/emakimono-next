# Dependencies and build output
node_modules/
.next/
out/
dist/
build/
coverage/
.cache/
.turbo/

# Lockfiles and logs
package-lock.json
pnpm-lock.yaml
yarn.lock
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# High-res emaki images and static media
public/emaki-images/
public/emaki/
public/images/
public/ogp/
public/thumb/
public/svg/
public/unused/
public/data/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.svg
*.mp4
*.mov
*.webm
*.zip
*.pdf

# Sitemap (generated by next-sitemap)
public/sitemap*.xml

# Large static metadata / tile data
# NOTE: blanket `*.json` is intentionally NOT used — the following stay indexed:
#   - public/locales/{ja,en}/common.json (i18n UI strings)
#   - config JSON (package.json, tsconfig.json, next.config.js, etc.)
# Heavy data dirs are excluded explicitly instead (comment out when editing scroll metadata).
public/data/
*.geojson
*.xml
local-data/
src/data/image-metadata-cache/
src/data/emaki-text-data/
src/data/chronology/
src/data/withdrawn/

# Local scroll workspace and sync outputs
scrolls/
analytics/reports/
analytics/content-map.json

# Archived / unused code
src/libs/_archive_unused_data/
src/components/_archive_unused/
src/styles/_archive_unused_styles/

# Image metadata backups
src/data/image-metadata-cache/*.bak
**/*.pre-migrate*.bak

# Secrets and local env
.env
.env.*
credentials.json
.vercel/

# Logs and caches
**/__pycache__/
*.pyc
.history/
cloudinary-usage.json
**/.upload-cache.json

# Docs outside operations (research/archival; gitignored locally)
docs/archive/
docs/concept/
docs/content/
memo/
