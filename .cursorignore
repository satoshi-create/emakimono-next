# ※ UIの多言語辞書（public/locales/）やルート設定JSONはインデックスを維持
# ==============================================================================
public/sitemap*.xml
public/data/
local-data/
drizzle/
*.sql
*.sqlite
*.db
*.csv
*.geojson
*.xml
*.json.map
*.tsbuildinfo

# 巨大テキスト辞書・メタデータキャッシュ実体（型定義 src/types/ で代用）
src/data/image-metadata-cache/
src/data/emaki-text-data/
src/data/chronology/
src/data/zukan/
src/data/withdrawn/
src/data/folklore/

# メタデータバックアップ
src/data/image-metadata-cache/*.bak
**/*.pre-migrate*.bak

# ==============================================================================
