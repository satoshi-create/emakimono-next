# ==============================================================================
scripts/
src/script/
**/__pycache__/
*.py
*.pyc
src/libs/_archive_unused_data/
src/components/_archive_unused/
src/styles/_archive_unused_styles/

# ==============================================================================
# 6. 環境変数・シークレット・デプロイ設定
# ==============================================================================
.env
.env.*
!.env.example
credentials.json
.vercel/
cloudinary-usage.json
**/.upload-cache.json

# ==============================================================================
# 7. リサーチ用ドキュメント・アナリティクス・一時ファイル
# ==============================================================================
docs/
memo/
analytics/
.history/
.tmp*

# ==============================================================================
# 8. Local scroll workspace and sync outputs (Whitelist control)
# ※ グローバルなメディア・ファイル除外の後に記述し、例外を確実に適用させる
# ==============================================================================
# ① scrolls 直下のファイル・フォルダを一旦すべて無視
scrolls/*

# ② 直下の README.md と各 scroll サブディレクトリ自体は走査を許可
!scrolls/README.md
!scrolls/*/

# ③ 各 scroll サブディレクトリ配下を原則除外
scrolls/*/*

# ④ 必要な設定・ソース・画像をピンポイントで復活（ホワイトリスト）
!scrolls/*/scroll_config.yaml
!scrolls/*/sources/
!scrolls/*/sources/**
!scrolls/*/images/
!scrolls/*/images/**

# ⑤ 上記 images/ 配下の画像バイナリをセクション4のグローバル除外から確実に除外解除
!scrolls/*/images/*.png
!scrolls/*/images/*.jpg
!scrolls/*/images/*.jpeg
!scrolls/*/images/*.webp
!scrolls/*/images/*.svg